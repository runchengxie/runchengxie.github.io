---
import {t,type Locale,type MessageKey} from "../i18n";
import english from "../i18n/en";
import {styleIds,metricIds,researchSources} from "../lib/research-showcase";
interface Props {locale:Locale;}
const {locale}=Astro.props;
const messages=Object.fromEntries(Object.keys(english).filter(key=>key.startsWith("research.")).map(key=>[key,t(locale,key as MessageKey)]));
const studies=[
  {id:"market",title:"research.market.title",question:"research.market.question",method:"research.market.method",limits:"research.market.limits",url:"https://runchengxie.github.io/quant-market-research/research/style-factors-18y/"},
  {id:"factor",title:"research.factor.title",question:"research.factor.question",method:"research.factor.method",limits:"research.factor.limits",url:"https://runchengxie.github.io/quant-factor-observatory/studies/pb-roe/"},
] as const;
---
<section class="portfolio-section research-showcase" aria-labelledby="research-showcase" data-research-showcase data-research-locale={locale} data-messages={JSON.stringify(messages)}>
  <span id="demos-heading" aria-hidden="true"></span>
  <div class="section-heading"><h2 id="research-showcase">{t(locale,"research.section")}</h2></div>
  <p class="section-description">{t(locale,"research.intro")}</p>
  <p class="sr-only" aria-live="polite" data-research-announcement></p>
  <noscript><p class="research-scope">{t(locale,"research.noScript")}</p></noscript>
  {studies.map((study,index)=><article class="research-panel" data-study={study.id} data-state="idle" aria-busy="false" aria-labelledby={`${study.id}-research-title`}>
    <div class="research-panel-heading">
      <div><p class="eyebrow">0{index+1} · {t(locale,"research.history")}</p><h3 id={`${study.id}-research-title`}>{t(locale,study.title)}</h3></div>
      <label class="research-filter">{t(locale,study.id==="market"?"research.market.control":"research.factor.metric")}
        <select disabled data-research-control={study.id}>
          {study.id==="market"?styleIds.map(id=><option value={id}>{t(locale,`research.style.${id}`)}</option>):metricIds.map(id=><option value={id}>{t(locale,`research.metric.${id}`)}</option>)}
        </select>
      </label>
    </div>
    <p class="research-question">{t(locale,study.question)}</p>
    <p class="research-method">{t(locale,study.method)}</p>
    <div class="research-status" aria-live="polite"><p data-source-status hidden>{t(locale,"research.loading")}</p><button type="button" data-research-retry hidden>{t(locale,"research.retry")}</button></div>
    <div data-research-result hidden>
      <p class="research-period" data-research-period></p>
      <figure class="research-figure">
        <figcaption data-research-caption>{t(locale,study.id==="market"?"research.market.plot":"research.metric.annualReturn")}</figcaption>
        <p class="research-unit" data-research-unit></p>
        <div class="research-chart" data-research-chart aria-hidden="true"></div>
        {study.id==="market"&&<p class="research-help">{t(locale,"research.market.interval")}</p>}
      </figure>
      <details class="research-values" open={study.id === "factor"}>
        <summary>{t(locale,"research.values")}</summary>
        <div class="research-table-scroll"><table><caption class="sr-only">{t(locale,study.title)}</caption><thead><tr><th scope="col">{t(locale,study.id==="market"?"research.market.yearColumn":"research.comparison")}</th><th scope="col">{t(locale,"research.value")}</th>{study.id==="market"&&<><th scope="col">{t(locale,"research.market.periodColumn")}</th><th scope="col">{t(locale,"research.market.daysColumn")}</th></>}</tr></thead><tbody data-research-values></tbody></table></div>
      </details>
      <p class="research-version" data-research-version></p>
    </div>
    <p class="research-scope">{t(locale,study.limits)}</p>
    <div class="research-links"><a href={study.id === "market" ? `${study.url}?lang=${locale === "zh" ? "zh-CN" : "en-US"}` : study.url} data-study-link>{t(locale,"research.fullStudy")} ↗</a><a href={researchSources[study.id]}>{t(locale,"research.sourceData")} ↗</a></div>
    <details class="research-provenance"><summary>{t(locale,"research.sourceDetails")}</summary>
      {study.id==="market"&&<p>{t(locale,"research.market.allControls")}</p>}
      <dl data-research-provenance></dl>
    </details>
  </article>)}
</section>
<script>
  import {initializeResearchShowcase} from "../lib/research-showcase-browser";
  document.querySelectorAll<HTMLElement>("[data-research-showcase]").forEach(initializeResearchShowcase);
</script>
