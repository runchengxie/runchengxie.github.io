---
import { t, type Locale } from "../i18n";
import type { BlogPost } from "../lib/posts";
import {
  formatShortDate,
  getExcerpt,
  getPostHref,
} from "../lib/posts";

interface Props {
  posts: BlogPost[];
  locale: Locale;
}

const { posts, locale } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li class="post-list__item">
        <time datetime={post.data.date.toISOString()}>
          {formatShortDate(post.data.date, locale)}
        </time>
        <div lang={post.collection === "blog" ? "zh-CN" : "en"}>
          <h2>
            <a href={getPostHref(post, locale)}>{post.data.title}</a>
          </h2>
          <p>{getExcerpt(post.body ?? "", locale === "en" ? 200 : 116, locale)}</p>
          <ul class="tag-list" aria-label={t(locale, "blog.categories")}>
            {post.data.categories.map((category) => (
              <li>{category}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>
