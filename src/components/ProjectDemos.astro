---
import {t,languageTag,type Locale,type MessageKey} from "../i18n";
import {marketFields,sampleMarketRows,checkMarketRows,calculateRebalance} from "../lib/project-demos";
interface Props {locale:Locale;}
const {locale}=Astro.props;
const keys=["demo.data.summary","demo.data.empty","demo.data.noIssues","demo.data.issue","demo.data.fieldLabel","demo.issue.required","demo.issue.date","demo.issue.price","demo.issue.volume","demo.issue.duplicate","demo.field.date","demo.field.symbol","demo.field.close","demo.field.volume","demo.rebalance.error.weights","demo.rebalance.error.totals","demo.rebalance.error.value","demo.rebalance.error.fee"] satisfies MessageKey[];
const messages=Object.fromEntries(keys.map(key=>[key,t(locale,key)]));
const report=checkMarketRows(sampleMarketRows);
const number=new Intl.NumberFormat(languageTag(locale),{maximumFractionDigits:2});
const percent=new Intl.NumberFormat(languageTag(locale),{style:"percent",maximumFractionDigits:2});
const current=[50,30,20],target=[30,40,30];
const result=calculateRebalance(current,target,100000,10);
const metrics=["buy","sell","traded","turnover","fee"] as const;
const values=result.ok?[result.buyAmount,result.sellAmount,result.tradedAmount,result.turnover,result.fee]:[];
---
<section class="portfolio-section project-demos" aria-labelledby="demos-heading" data-project-demos data-demo-locale={locale} data-messages={JSON.stringify(messages)}>
  <div class="section-heading"><h2 id="demos-heading">{t(locale,"demo.section")}</h2></div>
  <p class="section-description">{t(locale,"demo.intro")}</p>
  <noscript><p class="demo-notice">{t(locale,"demo.noScript")}</p></noscript>
  <div class="demo-panels">
    <article class="demo-panel" aria-labelledby="data-demo-heading">
      <p class="eyebrow">01 · {t(locale,"demo.sample")}</p>
      <h3 id="data-demo-heading">{t(locale,"demo.data.title")}</h3>
      <p class="demo-description">{t(locale,"demo.data.intro")}</p>
      <form data-market-form>
        <fieldset disabled data-demo-controls>
          <legend class="sr-only">{t(locale,"demo.data.caption")}</legend>
          <div class="demo-table-scroll" tabindex="0" role="region" aria-label={t(locale,"demo.data.caption")}>
            <table class="demo-table">
              <caption class="sr-only">{t(locale,"demo.data.caption")}</caption>
              <thead><tr><th scope="col">{t(locale,"demo.row")}</th>{marketFields.map(field=><th scope="col">{t(locale,`demo.field.${field}`)}</th>)}</tr></thead>
              <tbody data-market-body>{sampleMarketRows.map((row,index)=><tr><th scope="row">{number.format(index+1)}</th>{marketFields.map(field=><td><input type={field==="date"||field==="symbol"?"text":"number"} step="any" value={row[field]} data-field={field} data-row={index} aria-label={t(locale,"demo.data.fieldLabel",{row:index+1,field:t(locale,`demo.field.${field}`)})} /></td>)}</tr>)}</tbody>
            </table>
          </div>
          <p class="demo-scroll-hint">{t(locale,"demo.scrollHint")}</p>
          <div class="demo-actions"><button type="button" data-clean>{t(locale,"demo.data.clean")}</button><button type="button" data-add>{t(locale,"demo.data.add")}</button><button type="button" data-reset-market>{t(locale,"demo.reset")}</button></div>
        </fieldset>
      </form>
      <p class="demo-help">{t(locale,"demo.data.limit")}</p>
      <div class="demo-report" aria-live="polite" aria-atomic="true">
        <p data-market-summary>{t(locale,"demo.data.summary",{total:report.totalRows,valid:report.validRows,issues:report.issues.length})}</p>
        <ul data-market-issues>{report.issues.map(issue=><li>{t(locale,"demo.data.issue",{row:issue.row,field:t(locale,`demo.field.${issue.field}`),reason:t(locale,`demo.issue.${issue.code}`)})}</li>)}</ul>
      </div>
      <details class="demo-rules"><summary>{t(locale,"demo.data.rulesTitle")}</summary><p>{t(locale,"demo.data.rules")}</p></details>
      <a class="demo-project-link" href="https://runchengxie.github.io/quant-market-data-platform/">{t(locale,"demo.data.project")} ↗</a>
    </article>
    <article class="demo-panel" aria-labelledby="rebalance-demo-heading">
      <p class="eyebrow">02 · {t(locale,"demo.sample")}</p>
      <h3 id="rebalance-demo-heading">{t(locale,"demo.rebalance.title")}</h3>
      <p class="demo-description">{t(locale,"demo.rebalance.intro")}</p>
      <form data-rebalance-form>
        <fieldset disabled data-demo-controls>
          <legend class="sr-only">{t(locale,"demo.rebalance.caption")}</legend>
          <div class="demo-parameters">
            <label>{t(locale,"demo.rebalance.value")}<input type="number" min="0.01" max="1000000000000" step="any" value="100000" data-portfolio-value /></label>
            <label>{t(locale,"demo.rebalance.feeRate")}<input type="number" min="0" max="1000" step="any" value="10" data-fee-bps /></label>
          </div>
          <div class="demo-table-scroll" tabindex="0" role="region" aria-label={t(locale,"demo.rebalance.caption")}>
            <table class="demo-table">
              <caption class="sr-only">{t(locale,"demo.rebalance.caption")}</caption>
              <thead><tr><th scope="col">{t(locale,"demo.rebalance.asset")}</th><th scope="col">{t(locale,"demo.rebalance.current")}</th><th scope="col">{t(locale,"demo.rebalance.target")}</th><th scope="col">{t(locale,"demo.rebalance.change")}</th></tr></thead>
              <tbody>{current.map((weight,index)=><tr><th scope="row">{`ASSET-${String.fromCharCode(65+index)}`}</th><td><input type="number" min="0" max="100" step="any" value={weight} data-current-weight aria-label={t(locale,"demo.rebalance.fieldLabel",{asset:`ASSET-${String.fromCharCode(65+index)}`,field:t(locale,"demo.rebalance.current")})} /></td><td><input type="number" min="0" max="100" step="any" value={target[index]} data-target-weight aria-label={t(locale,"demo.rebalance.fieldLabel",{asset:`ASSET-${String.fromCharCode(65+index)}`,field:t(locale,"demo.rebalance.target")})} /></td><td data-trade>{result.ok?number.format(result.trades[index]??0):"—"}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="demo-scroll-hint">{t(locale,"demo.scrollHint")}</p>
          <div class="demo-actions"><button type="reset">{t(locale,"demo.reset")}</button></div>
        </fieldset>
      </form>
      <p class="demo-help">{t(locale,"demo.rebalance.units")}</p>
      <div aria-live="polite" aria-atomic="true">
        <p class="demo-error" data-rebalance-error hidden></p>
        <dl class="demo-metrics" data-rebalance-results>{metrics.map((metric,index)=><div><dt>{t(locale,`demo.rebalance.${metric}`)}</dt><dd data-metric={metric}>{metric==="turnover"?percent.format(values[index]??0):number.format(values[index]??0)}</dd></div>)}</dl>
      </div>
      <details class="demo-rules"><summary>{t(locale,"demo.rebalance.rulesTitle")}</summary><p>{t(locale,"demo.rebalance.rules")}</p></details>
      <a class="demo-project-link" href="https://runchengxie.github.io/quant-platform/">{t(locale,"demo.rebalance.project")} ↗</a>
    </article>
  </div>
</section>
<script>
  import { initializeProjectDemos } from "../lib/project-demos-browser";
  document.querySelectorAll<HTMLElement>("[data-project-demos]").forEach(initializeProjectDemos);
</script>
