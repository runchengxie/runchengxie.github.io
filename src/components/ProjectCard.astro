---
import { t, type Locale } from "../i18n";
import { projectText, repositoryURL, type Project } from "../data/projects";
interface Props { project: Project; locale: Locale; }
const { project, locale } = Astro.props;
const text = projectText(project, locale);
---
<article class="project-card">
  <p class="project-card__group">{text.group}</p>
  <h3>{text.title}</h3>
  <p class="project-card__name">{project.name}</p>
  <p class="project-card__description">{text.description}</p>
  <div class="project-card__links">
    {project.website && <a href={project.website}>{t(locale, "project.website")} <span aria-hidden="true">↗</span><span class="sr-only">: {text.title}</span></a>}
    <a href={repositoryURL(project.name)}>{t(locale, "project.code")} <span aria-hidden="true">↗</span><span class="sr-only">: {project.name}</span></a>
  </div>
</article>
