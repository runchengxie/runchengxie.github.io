---
import { t, type Locale } from "../i18n";
interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
---
<button
  class="theme-toggle"
  id="theme-toggle"
  type="button"
  aria-label={t(locale, "theme.toggle")}
  title={t(locale, "theme.toggle")}
  data-light-label={t(locale, "theme.light")}
  data-dark-label={t(locale, "theme.dark")}
>
  <svg class="theme-icon theme-icon--light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
  </svg>
  <svg class="theme-icon theme-icon--dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.3 15.2A8.5 8.5 0 0 1 8.8 3.7 8.5 8.5 0 1 0 20.3 15.2Z"></path>
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const root = document.documentElement;
  const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");

  function applyTheme(theme: "light" | "dark", persist = false) {
    root.dataset.theme = theme;
    themeColor?.setAttribute("content", theme === "dark" ? "#171815" : "#f7f6f2");
    toggle?.setAttribute(
      "aria-label",
      (theme === "dark" ? toggle?.dataset.lightLabel : toggle?.dataset.darkLabel) ?? "",
    );
    toggle?.setAttribute(
      "title",
      (theme === "dark" ? toggle?.dataset.lightLabel : toggle?.dataset.darkLabel) ?? "",
    );

    if (persist) { try { localStorage.setItem("theme", theme); } catch {} }
  }

  applyTheme(root.dataset.theme === "dark" ? "dark" : "light");

  toggle?.addEventListener("click", () => {
    applyTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    let saved = null;
    try { saved = localStorage.getItem("theme"); } catch {}
    if (saved === null) {
      applyTheme(event.matches ? "dark" : "light");
    }
  });
</script>
