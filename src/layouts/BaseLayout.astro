---
import ThemeToggle from "../components/ThemeToggle.astro";
import { NAVIGATION, SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  canonicalPath?: string;
}

const {
  title,
  description = SITE.description,
  image = "/images/buffett.jpg",
  type = "website",
  publishedTime,
  canonicalPath,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;

function isCurrent(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#f7f6f2" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved === "light" || saved === "dark"
          ? saved
          : (prefersDark ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        document.querySelector("#theme-color")?.setAttribute(
          "content",
          theme === "dark" ? "#171815" : "#f7f6f2",
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="site-name" href="/" aria-label={`${SITE.title} 主页`}>
          {SITE.title}
        </a>
        <div class="site-actions">
          <nav aria-label="主导航">
            <ul>
              {
                NAVIGATION.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="shell" id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p>© {new Date().getFullYear()} {SITE.author}</p>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
