---
import { t, localizedPath, type Locale } from "../i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout locale={locale} title={t(locale, "about.title")} description={t(locale, "about.description")}>
  <header class="page-heading about-heading" data-page-entry="about">
    <div class="about-heading__copy">
      <p class="eyebrow">{t(locale, "about.title")}</p>
      <h1>{t(locale, "about.heading")}</h1>
      <p>{t(locale, "about.description")}</p>
    </div>
    <div class="about-background" data-about-background aria-hidden="true">
      <svg class="about-candles" aria-hidden="true" focusable="false" viewBox="0 0 720 144" preserveAspectRatio="none" fill="none">
        <defs>
          <g id="about-candle-sequence">
            <g class="about-candle about-candle--filled"><path d="M18 56V100" /><rect x="13" y="66" width="10" height="22" /></g>
            <g class="about-candle"><path d="M54 46V90" /><rect x="49" y="56" width="10" height="20" /></g>
            <g class="about-candle"><path d="M90 36V80" /><rect x="85" y="46" width="10" height="20" /></g>
            <g class="about-candle about-candle--filled"><path d="M126 28V72" /><rect x="121" y="38" width="10" height="20" /></g>
            <g class="about-candle about-candle--filled"><path d="M162 44V88" /><rect x="157" y="54" width="10" height="20" /></g>
            <g class="about-candle"><path d="M198 54V98" /><rect x="193" y="64" width="10" height="20" /></g>
            <g class="about-candle"><path d="M234 46V90" /><rect x="229" y="56" width="10" height="20" /></g>
            <g class="about-candle about-candle--filled"><path d="M270 64V108" /><rect x="265" y="74" width="10" height="22" /></g>
            <g class="about-candle about-candle--filled"><path d="M306 74V118" /><rect x="301" y="84" width="10" height="20" /></g>
            <g class="about-candle"><path d="M342 62V106" /><rect x="337" y="72" width="10" height="22" /></g>
            <g class="about-candle"><path d="M378 46V90" /><rect x="373" y="56" width="10" height="22" /></g>
            <g class="about-candle"><path d="M414 32V76" /><rect x="409" y="42" width="10" height="22" /></g>
            <g class="about-candle about-candle--filled"><path d="M450 26V70" /><rect x="445" y="36" width="10" height="20" /></g>
            <g class="about-candle"><path d="M486 38V82" /><rect x="481" y="48" width="10" height="20" /></g>
            <g class="about-candle about-candle--filled"><path d="M522 54V98" /><rect x="517" y="64" width="10" height="22" /></g>
            <g class="about-candle about-candle--filled"><path d="M558 68V112" /><rect x="553" y="78" width="10" height="22" /></g>
            <g class="about-candle"><path d="M594 60V104" /><rect x="589" y="70" width="10" height="22" /></g>
            <g class="about-candle"><path d="M630 42V86" /><rect x="625" y="52" width="10" height="22" /></g>
            <g class="about-candle about-candle--filled"><path d="M666 50V94" /><rect x="661" y="60" width="10" height="22" /></g>
            <g class="about-candle"><path d="M702 36V82" /><rect x="697" y="46" width="10" height="22" /></g>
          </g>
        </defs>
        <g class="about-candles__track">
          <use href="#about-candle-sequence" />
          <use href="#about-candle-sequence" x="720" />
        </g>
      </svg>
    </div>
  </header>
  <div class="about-content reading-width">
    <section data-motion-kind="about" aria-labelledby="work-heading">
      <h2 id="work-heading">{t(locale, "about.work")}</h2>
      <p>{t(locale, "about.workFirst")}</p>
      <p>{t(locale, "about.workSecond")}</p>
      <a href={localizedPath(locale, "/projects/")}>{t(locale, "about.projects")} →</a>
    </section>
    <section data-motion-kind="about" aria-labelledby="principles-heading">
      <h2 id="principles-heading">{t(locale, "about.principles")}</h2>
      <ul>
        <li>{t(locale, "about.principleReproduce")}</li>
        <li>{t(locale, "about.principleEvidence")}</li>
        <li>{t(locale, "about.principleBoundaries")}</li>
        <li>{t(locale, "about.principleTools")}</li>
      </ul>
      <p>{t(locale, "about.stack")}</p>
    </section>
    <section data-motion-kind="about" aria-labelledby="writing-heading">
      <h2 id="writing-heading">{t(locale, "about.writing")}</h2>
      <p>{t(locale, "about.writingDetail")}</p>
      <p><a href={localizedPath(locale, "/blog/")}>{t(locale, "about.read")}</a> · <a href={localizedPath(locale, "/notes/investment-perspective/")}>{t(locale, "note.title")}</a></p>
    </section>
    <section data-motion-kind="about" aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading">{t(locale, "about.find")}</h2>
      <p>{t(locale, "about.findBefore")} · <a href="https://github.com/runchengxie">GitHub · runchengxie</a></p>
      <p>{t(locale, "about.findAfter")} · <a href={localizedPath(locale, "/rss.xml")}>RSS</a></p>
    </section>
  </div>
</BaseLayout>
