---
import { t, localizedPath, type Locale } from "../i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale={locale}
  title={t(locale, "error.title")}
  description={t(locale, "error.description")}
  canonicalPath={localizedPath(locale, "/404/")}
>
  <section class="page-heading">
    <p class="eyebrow">404</p>
    <h1>{t(locale, "error.title")}</h1>
    <p>{t(locale, "error.detail")}</p>
    <p><a href={localizedPath(locale)}>{t(locale, "nav.home")}</a> · <a href={localizedPath(locale, "/blog/")}>{t(locale, "nav.blog")}</a></p>
  </section>
</BaseLayout>
