---
import "../styles/home-editorial.css";
import homeCinema from "../styles/home-cinema.css?inline";
import { t, localizedPath, type Locale } from "../i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WaveBackground from "../components/WaveBackground.astro";
import { projects, researchEntrances, projectText } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedPosts } from "../lib/posts";
const latestPosts = (await getLocalizedPosts(locale)).slice(0, 3);
const featuredProjects = projects.filter((project) => project.featured);
---
<BaseLayout locale={locale} fullBleed>
  <Fragment slot="head">
  <style is:inline set:html={homeCinema} />

  </Fragment>
  <div class="home-editorial">
  <section id="home-intro" class="personal-intro" aria-labelledby="intro-heading">
    <svg class="intro-frame" aria-hidden="true" viewBox="0 0 1120 720" preserveAspectRatio="none" fill="none">
      <path pathLength="1" d="M0 10H1120M0 710H1120" />
    </svg>
    <div class="personal-intro__copy">
      <p class="eyebrow">Richard / runchengxie</p>
      <h1 id="intro-heading"><span class="intro-title-line">{t(locale, "home.headingFirst")}</span><span class="intro-title-line">{t(locale, "home.headingSecond")}</span></h1>
      <p class="personal-intro__description">{t(locale, "home.intro")}</p>
      <div class="intro-links">
        <a class="button-link" href="#research-heading">{t(locale, "home.explore")} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <WaveBackground locale={locale} />
    <p class="home-focus"><span>{t(locale, "home.focus")}</span>{t(locale, "home.focusSummary")}</p>
  </section>
  <section class="portfolio-section" aria-labelledby="research-heading">
    <div class="section-heading"><h2 id="research-heading">{t(locale, "home.public")}</h2><a href={localizedPath(locale, "/projects/")}>{t(locale, "home.allProjects")} →</a></div>
    <div class="research-entrances">
      {researchEntrances.map((project) => <a href={project.website} class="research-entrance">
        <h3>{projectText(project, locale).title} <span aria-hidden="true">↗</span></h3>
        <p>{projectText(project, locale).description}</p>
      </a>)}
    </div>
  </section>
  <section class="portfolio-section" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">{t(locale, "home.featured")}</h2><a href={localizedPath(locale, "/projects/")}>{t(locale, "home.projectMap")} →</a></div>
    <p class="section-description">{t(locale, "home.projectIntro")}</p>
    <div class="project-grid">{featuredProjects.filter((p) => !researchEntrances.includes(p)).map((project) => <ProjectCard locale={locale} project={project} compact />)}</div>
  </section>
  <section class="home-latest" aria-labelledby="latest-heading">
    <div class="section-heading"><h2 id="latest-heading">{t(locale, "home.writing")}</h2><a href={localizedPath(locale, "/blog/")}>{t(locale, "home.allPosts")} →</a></div>
    <p class="section-description">{t(locale, "home.writingIntro")}</p>
    <PostList locale={locale} posts={latestPosts} compact />
  </section>
</div>
</BaseLayout>

<script>
  import { initializeHomeEntry } from "../lib/home-entry";
  initializeHomeEntry();
</script>
