---
import { getCollection } from "astro:content";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, researchEntrances } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortPosts } from "../lib/posts";
const latestPosts = sortPosts(await getCollection("blog")).slice(0, 3);
const featuredProjects = projects.filter((project) => project.featured);
---
<BaseLayout>
  <section class="personal-intro" aria-labelledby="intro-heading">
    <div>
      <p class="eyebrow">Richard / runchengxie</p>
      <h1 id="intro-heading">研究市场，<br />也把想法做成工具。</h1>
      <p class="personal-intro__description">你好，我是 Richard。我开发量化研究和交易工具，关注市场数据、因子与模型、组合构建和回测，也写投资案例与长期投资思考。</p>
      <div class="intro-links">
        <a class="button-link" href="/projects/">探索项目 <span aria-hidden="true">→</span></a>
        <a href="/about/">关于我</a>
        <a href="https://github.com/runchengxie">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="work-note" aria-labelledby="work-note-heading">
      <p class="eyebrow" id="work-note-heading">当前关注</p>
      <ol>
        <li><span>01</span>可靠的市场数据</li>
        <li><span>02</span>可复现的量化研究</li>
        <li><span>03</span>有证据的投资判断</li>
      </ol>
      <p>让数据、方法和结果之间的关系更清楚。</p>
    </aside>
  </section>
  <section class="portfolio-section" aria-labelledby="research-heading">
    <div class="section-heading"><h2 id="research-heading">从公开成果开始</h2><a href="/projects/">全部项目 →</a></div>
    <div class="research-entrances">
      {researchEntrances.map((project, index) => <a href={project.website} class="research-entrance">
        <span class="research-entrance__number">0{index + 1}</span>
        <h3>{project.title} <span aria-hidden="true">↗</span></h3>
        <p>{project.description}</p>
      </a>)}
    </div>
  </section>
  <section class="portfolio-section" aria-labelledby="projects-heading">
    <div class="section-heading"><h2 id="projects-heading">精选项目</h2><a href="/projects/">查看项目关系 →</a></div>
    <p class="section-description">从数据准备到研究检验，再到结果发布。每个项目负责其中一部分，通过明确的格式和接口协作。</p>
    <div class="project-grid">{featuredProjects.filter((p) => !researchEntrances.includes(p)).map((project) => <ProjectCard project={project} />)}</div>
  </section>
  <section class="home-latest" aria-labelledby="latest-heading">
    <div class="section-heading"><h2 id="latest-heading">投资与思考</h2><a href="/blog/">全部文章 →</a></div>
    <p class="section-description">巴菲特案例、企业研究，以及投资中值得反复审视的判断。</p>
    <PostList posts={latestPosts} />
  </section>
</BaseLayout>
