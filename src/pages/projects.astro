---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, projectGroups } from "../data/projects";
---
<BaseLayout title="项目" description="Richard 的公开项目：市场数据、研究与回测、因子与模型、市场报告和交易实验。">
  <header class="page-heading">
    <p class="eyebrow">项目与研究</p>
    <h1>从数据到研究，<br />从想法到工具。</h1>
    <p>这里精选我当前的公开工作。先读成果，或进入代码与文档，了解每个项目解决的问题。</p>
  </header>
  <nav class="project-navigation" aria-label="项目分类">{projectGroups.map((group, i) => <a href={`#group-${i}`}>{group}</a>)}</nav>
  <section class="project-map" aria-labelledby="map-heading">
    <h2 id="map-heading">这些项目怎样配合</h2>
    <ol>
      <li><strong>准备数据</strong><span>市场数据平台采集、检查并发布版本化数据。</span></li>
      <li><strong>检验想法</strong><span>研究项目使用数据，回测框架提供组合与风险工具，运行工具执行任务。</span></li>
      <li><strong>公开成果</strong><span>研究网站、因子观测站和市场日报呈现各自审核后的内容。</span></li>
    </ol>
    <p>策略细节和完整实验记录保留在私有研究中。公开页面说明各自的样本、方法与限制；演示数据、历史回测和实际运行结果需分别看待。</p>
  </section>
  {projectGroups.map((group, i) => <section class="portfolio-section" aria-labelledby={`group-${i}`}>
    <div class="section-heading"><h2 id={`group-${i}`}>{group}</h2></div>
    <div class="project-grid">{projects.filter((project) => project.group === group).map((project) => <ProjectCard project={project} />)}</div>
  </section>)}
  <p class="portfolio-closing">更多代码与实验见 <a href="https://github.com/runchengxie?tab=repositories">GitHub 仓库列表 ↗</a>。</p>
</BaseLayout>
